NODE_ENV=development
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

POSTGRES_URL=postgresql://askme:askme@postgres:5432/askme
MONGODB_URL=mongodb://mongodb:27017/askme
REDIS_URL=redis://redis:63179

GROQ_API_KEY=change-me
GROQ_MODEL=llama-3.1-8b-instant
GROQ_NARRATIVE_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=change-me
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:15173
OPENROUTER_APP_TITLE=AskMe Studio
LLM_NARRATIVE_ENABLED=true
NARRATIVE_TEMPERATURE=0.3
NARRATIVE_TOP_P=0.9
NARRATIVE_MAX_COMPLETION_TOKENS=1000
DEFAULT_SEMANTIC_LAYER_LANGUAGE=en

# Text-to-SQL generation.
# static = deterministic planner only, ollama = local model, groq = Groq API, openrouter = OpenRouter API,
# auto = Ollama then Groq then OpenRouter.
TEXT_TO_SQL_PROVIDER=groq
TEXT_TO_SQL_OLLAMA_ENABLED=true
TEXT_TO_SQL_GROQ_ENABLED=true
TEXT_TO_SQL_OPENROUTER_ENABLED=true
TEXT_TO_SQL_MODEL=
OLLAMA_SQL_MODEL=qwen2.5-coder:7b
GROQ_SQL_MODEL=llama-3.1-8b-instant
OPENROUTER_SQL_MODEL=openai/gpt-4o-mini
TEXT_TO_SQL_TIMEOUT_MS=15000
SQL_GENERATION_TEMPERATURE=0
SQL_GENERATION_TOP_P=0.85
SQL_GENERATION_MAX_COMPLETION_TOKENS=512
SQL_GENERATION_FREQUENCY_PENALTY=0
SQL_GENERATION_PRESENCE_PENALTY=0
TEXT_TO_SQL_MAX_TOKENS=512
TEXT_TO_SQL_TEMPERATURE=0
TEXT_TO_SQL_MAX_CONTEXT_TABLES=3
TEXT_TO_SQL_MAX_CONTEXT_COLUMNS_PER_TABLE=12
TEXT_TO_SQL_MAX_CONTEXT_KPIS=5
TEXT_TO_SQL_MAX_CONTEXT_SYNONYMS=6
TEXT_TO_SQL_MAX_CONTEXT_RELATIONSHIPS=8
TEXT_TO_SQL_MAX_CONTEXT_RETRIEVAL_HINTS=5
TEXT_TO_SQL_MAX_PROMPT_CONTEXT_CHARS=10000
SEMANTIC_SEARCH_TOP_K=10
SEMANTIC_SEARCH_MMR=0.4
SEMANTIC_SEARCH_SIMILARITY_THRESHOLD=0.1
OLLAMA_BASE_URL=http://host.docker.internal:11434

QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=500
